#!/usr/bin/env bash
# Repository pre-commit hook (configure: git config core.hooksPath .githooks)
#
# 1. gitleaks protect --staged  (skip: SKIP_GITLEAKS=1)
# 2. HITT build version bump     (skip: SKIP_HITT_VERSION_HOOK=1)
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
GITLEAKS_CONFIG="${ROOT}/.gitleaks.toml"

run_gitleaks() {
  [[ "${SKIP_GITLEAKS:-0}" == "1" ]] && return 0

  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed or not on PATH." >&2
    echo "  Install: bash scripts/install-git-hooks.sh" >&2
    echo "  Or skip once: SKIP_GITLEAKS=1 git commit ..." >&2
    exit 1
  fi

  if [[ ! -f "${GITLEAKS_CONFIG}" ]]; then
    echo "pre-commit: missing ${GITLEAKS_CONFIG}" >&2
    exit 1
  fi

  echo "pre-commit: scanning staged changes with gitleaks ..."
  gitleaks protect \
    --staged \
    --verbose \
    --redact \
    --config "${GITLEAKS_CONFIG}"
}

run_gitleaks

if [[ -x "${ROOT}/.githooks/pre-commit-hitt-version" ]]; then
  "${ROOT}/.githooks/pre-commit-hitt-version"
fi

exit 0
